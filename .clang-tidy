# .clang-tidy — lasviewer's naming rules, enforced by scripts/lint.sh (and CI).
#
#   Types (class, struct, enum, alias), template parameters   CamelCase
#   Functions, methods, variables, parameters, members        camelBack
#   Private and protected members                             camelBack_ (trailing _)
#   Constants (constexpr, global/static const)                kCamelCase
#   Enum values                                               CamelCase
#   Namespaces                                                lower_case
#   Macros                                                    UPPER_CASE
#   One or two capitals (math notation: affine A..F, matrices V, P, VP,
#   sizes W, H, levels L, K) are allowed for variables, parameters, members
#   and local constants.
#
# Only naming is enforced. Other checks can be run ad hoc, e.g.
#   clang-tidy --checks='-*,bugprone-*,performance-*' <file> -- <flags>
# (scripts/lint.sh prints the flags it uses).

Checks: '-*,readability-identifier-naming'
WarningsAsErrors: '*'
# Project headers only (not the staged third-party ones under */build/).
HeaderFilterRegex: '(^|/)(Geo/include|Viewer/local/include)/'

CheckOptions:
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.MemberCase: camelBack
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.PrivateMemberSuffix: '_'
  readability-identifier-naming.ProtectedMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberSuffix: '_'
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
  readability-identifier-naming.LocalConstantCase: camelBack
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  # atf-c++ test cases keep their snake_case names (the macros derive
  # function and class names from them, and Kyua reports them).
  readability-identifier-naming.FunctionIgnoredRegexp: '^atfu_.*'
  readability-identifier-naming.VariableIgnoredRegexp: '^[A-Z][A-Z]?$'
  readability-identifier-naming.ParameterIgnoredRegexp: '^[A-Z][A-Z]?$'
  readability-identifier-naming.MemberIgnoredRegexp: '^[A-Z][A-Z]?$'
  readability-identifier-naming.LocalConstantIgnoredRegexp: '^[A-Z][A-Z]?$'
  readability-identifier-naming.ClassIgnoredRegexp: '^atfu_.*'
