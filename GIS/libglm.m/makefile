# Header-only: glm ships no library and no pkg-config file. IMPORT_LIB=none
# makes bmake-it look for the headers (glm/ under a tool prefix) instead of
# a lib file, and stage no library; REQUIRES=header: checks it up front.
LIB=glm
IMPORT=pkg:glm
IMPORT_LIB=none
REQUIRES=header:glm/glm.hpp
IMPORT_HEADERS=glm
.include "mk.lib.mk"
