# .clang-format — lasviewer's formatting, enforced by scripts/lint.sh (and
# CI): `scripts/lint.sh` checks, `scripts/lint.sh --fix` reformats. Pinned
# to clang-format 22 (CI installs the same version; other versions may
# format slightly differently).

BasedOnStyle: LLVM

Language: Cpp
Standard: c++17

ColumnLimit: 100
IndentWidth: 4
TabWidth: 4
UseTab: Never

BreakBeforeBraces: Attach
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortFunctionsOnASingleLine: Inline
AllowShortBlocksOnASingleLine: Never

AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignTrailingComments: true
AlignEscapedNewlines: Left

SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:            # blocks: project, third-party libraries, standard library
  - Regex: '^"'
    Priority: 1
  - Regex: '^<(GLFW|OpenGL|glm|lazperf|copc-lib|imgui|atf-c\+\+)[/.>]'
    Priority: 2
  - Regex: '^<(gdal|cpl_|ogr_|omp)'
    Priority: 2
  - Regex: '^<'
    Priority: 3

SpaceBeforeParens: ControlStatements
SpacesBeforeTrailingComments: 1

PointerAlignment: Left
DerivePointerAlignment: false

ReflowComments: true
